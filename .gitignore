# ==========================
# Vulcan Project
# ==========================

# Generated stack output (docker-compose.yml, .env, etc.) - produced on
# the end user's machine by the installer, never committed here.
stack/

# Backup archives (vulcan backup) - may contain real credentials from
# stack/.env, never committed here.
backups/

# Image tarballs (vulcan export) - large, machine-specific artifacts,
# never committed here.
exports/

# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class

*.egg-info/
dist/
build/

# mkdocs local build output (docs.yml deploys straight to the
# gh-pages branch, never commits this to main)
site/

.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# ==========================
# Development Tools
# ==========================
.vscode/
.idea/
*.swp
*.swo

# ==========================
# Operating System
# ==========================
.DS_Store
Thumbs.db

# ==========================
# Testing
# ==========================
.coverage
htmlcov/

# ==========================
# Backup Files
# ==========================
*.bak
*.backup
*.old

# agent tooling scratch
.omo/
.serena/
