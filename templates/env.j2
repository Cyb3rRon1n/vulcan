MEDIA_PATH={{ media_path }}
PUID={{ puid }}
PGID={{ pgid }}
TZ={{ timezone }}
{% if gluetun_enabled %}

# Gluetun VPN - fill these in before starting the stack. Provider-specific
# setup: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER={{ vpn_service_provider }}
VPN_TYPE={{ vpn_type }}
WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}
# Only some providers need this (e.g. Mullvad, Surfshark) - leave blank if
# your provider's setup page doesn't mention it (e.g. ProtonVPN, NordVPN).
WIREGUARD_ADDRESSES={{ wireguard_addresses }}
{% endif %}
{% if tailscale_enabled %}

# Tailscale - fill in a real auth key before starting the stack.
# Generate one: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY={{ tailscale_authkey }}
{% endif %}
{% if cloudflare_dns_enabled %}

# Cloudflare DNS-01 - real Let's Encrypt certificates via Traefik, instead
# of its self-signed default. Needs a scoped API token with Zone:DNS:Edit
# on the zone your domain lives in: https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN={{ cloudflare_dns_api_token }}
CLOUDFLARE_ACME_EMAIL={{ cloudflare_acme_email }}
{% endif %}
{% if vaultwarden_enabled %}

# Vaultwarden - generate a real admin token before relying on its admin
# panel: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN={{ vaultwarden_admin_token }}
# Leave "true" until you've created every account you need, then set to
# "false" and restart the container to stop accepting new signups.
VAULTWARDEN_SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed }}
{% endif %}
{% if crowdsec_enabled %}

# CrowdSec - a real, randomly generated shared key between Traefik's
# bouncer plugin and CrowdSec's own local API. Generated by Vulcan, not
# a credential to fill in yourself.
CROWDSEC_BOUNCER_KEY={{ crowdsec_bouncer_key }}
{% endif %}
{% if cloudflared_enabled %}

# Cloudflare Tunnel - fill in a real Tunnel token before starting the
# stack. Create one: Zero Trust dashboard > Networks > Tunnels > Create a
# tunnel > Docker tab (copy the token from the run command shown there,
# not the whole command). See the walkthrough for the Public Hostname step.
TUNNEL_TOKEN={{ tunnel_token }}
{% endif %}
