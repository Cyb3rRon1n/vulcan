MEDIA_PATH={{ media_path }}
PUID={{ puid }}
PGID={{ pgid }}
TZ={{ timezone }}
{% if gluetun_enabled %}

# Gluetun VPN - fill these in before starting the stack. Provider-specific
# setup: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER={{ vpn_service_provider }}
VPN_TYPE={{ vpn_type }}
WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}
{% endif %}
{% if tailscale_enabled %}

# Tailscale - fill in a real auth key before starting the stack.
# Generate one: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY={{ tailscale_authkey }}
{% endif %}
{% if cloudflare_dns_enabled %}

# Cloudflare DNS-01 - real Let's Encrypt certificates via Traefik, instead
# of its self-signed default. Needs a scoped API token with Zone:DNS:Edit
# on the zone your domain lives in: https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN={{ cloudflare_dns_api_token }}
CLOUDFLARE_ACME_EMAIL={{ cloudflare_acme_email }}
{% endif %}
