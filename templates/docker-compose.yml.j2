{% if 'qbittorrent' in enabled %}
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/qbittorrent:/config
      - ${MEDIA_PATH}:/data
{% if 'gluetun' in enabled %}
    network_mode: "service:gluetun"
    # service_healthy, not the default service_started: qBittorrent
    # shares gluetun's network namespace, so if it starts before
    # gluetun's VPN handshake finishes, runc fails to attach with a
    # cryptic "namespace path ... no such file or directory". Waiting on
    # gluetun's (image-defined) healthcheck removes that race.
    depends_on:
      gluetun:
        condition: service_healthy
{% else %}
    ports:
      - "{{ ports['qbittorrent'] }}:8080"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.qbittorrent.rule=Host(`qbittorrent.{{ domain }}`)"
      - "traefik.http.routers.qbittorrent.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.qbittorrent.tls=true"
{% if cloudflare_dns %}
