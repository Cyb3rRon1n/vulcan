{% if 'pihole' in enabled %}
  unbound:
    image: klutchell/unbound:latest
    container_name: unbound
    ports:
      - "{{ ports['pihole'] }}:80"
    volumes:
      # Mount the OVERRIDE dir, not /etc/unbound itself - the image
      # ships a complete working unbound.conf that already does
      # recursive resolution and `include`s custom.conf.d/*.conf.
      # Mounting an empty host dir over /etc/unbound hid that config
      # ("Could not open /etc/unbound/unbound.conf") and unbound
      # crash-looped, taking pihole (network_mode: service:unbound)
      # with it.
      - ./config/pihole/unbound:/etc/unbound/custom.conf.d
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.pihole.cpus }}"
          memory: "{{ limits.pihole.memory }}"
    restart: unless-stopped

  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    depends_on:
      - unbound
    environment:
      - TZ=${TZ}
      # pihole v6 reads upstreams from FTLCONF_dns_upstreams. This was
      # shipped as an empty string, which pihole took literally - "no
      # upstream servers configured", every lookup SERVFAIL. Point it at
      # unbound (running in the same netns on :5335, see the unbound
      # service + config/pihole/unbound/99-pihole-port.conf).
      - FTLCONF_dns_upstreams=127.0.0.1#5335
      - WEBPASSWORD=${PIHOLE_WEBPASSWORD}
      # Run pihole-FTL as root so it doesn't need to setcap itself at
      # start - no-new-privileges:true blocks that, and the image's own
      # error message names this exact env var as the fix.
      - DNSMASQ_USER=root
    volumes:
      - ./config/pihole/etc:/etc/pihole
      - ./config/pihole/dnsmasq:/etc/dnsmasq.d
    network_mode: "service:unbound"
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - NET_BIND_SERVICE
      - NET_ADMIN
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.pihole.cpus }}"
          memory: "{{ limits.pihole.memory }}"
    restart: unless-stopped
{% endif %}
