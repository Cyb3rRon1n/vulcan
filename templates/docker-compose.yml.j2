  metube:
    image: ghcr.io/alexta69/metube
    container_name: metube
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
    volumes:
      - ${MEDIA_PATH}/media/youtube:/downloads
    ports:
      - "{{ ports['metube'] }}:8081"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.metube.rule=Host(`metube.{{ domain }}`)"
      - "traefik.http.routers.metube.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.metube.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.metube.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.metube.loadbalancer.server.port=8081"
{% if 'crowdsec' in enabled or 'authelia' in enabled %}
      - "traefik.http.routers.metube.middlewares={{ [('crowdsec@docker' if 'crowdsec' in enabled else none), ('authelia@docker' if 'authelia' in enabled else none)] | select | join(',') }}"
{% endif %}
{% endif %}
    # Verified empirically (docker run --cap-drop=ALL against the real
    # image, then iterated caps back in) - same 5-capability pattern as
    # the linuxserver.io images: CHOWN/DAC_OVERRIDE/FOWNER for an
    # ownership fixup on first boot, SETGID/SETUID for a root -> PUID/
    # PGID privilege drop. See ROADMAP.md's cap_drop entry.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
