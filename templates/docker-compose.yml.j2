{% if 'recyclarr' in enabled %}
  recyclarr:
    image: ghcr.io/recyclarr/recyclarr:8
    container_name: recyclarr
    user: "${PUID}:${PGID}"
    environment:
      - TZ=${TZ}
      - CRON_SCHEDULE=@daily
      - RECYCLARR_CREATE_CONFIG=true
    volumes:
      - ./config/recyclarr:/config
