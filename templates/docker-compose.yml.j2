{% if 'pihole' in enabled %}
  unbound:
    image: klutchell/unbound:latest
    container_name: unbound
    ports:
      - "{{ ports['pihole'] }}:80"
    volumes:
      - ./config/pihole/unbound:/etc/unbound
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.pihole.cpus }}"
          memory: "{{ limits.pihole.memory }}"
    restart: unless-stopped

  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    depends_on:
      - unbound
    environment:
      - TZ=${TZ}
      - PIHOLE_DNS_=127.0.0.1#5335
      - FTLCONF_dns_upstreams=
      - PIHOLE_DNS=127.0.0.1#5335
      - WEBPASSWORD=${PIHOLE_WEBPASSWORD}
    volumes:
      - ./config/pihole/etc:/etc/pihole
      - ./config/pihole/dnsmasq:/etc/dnsmasq.d
    network_mode: "service:unbound"
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - NET_ADMIN
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.pihole.cpus }}"
          memory: "{{ limits.pihole.memory }}"
    restart: unless-stopped
{% endif %}
