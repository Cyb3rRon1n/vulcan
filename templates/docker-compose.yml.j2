services:
{% if 'jellyfin' in enabled %}
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/jellyfin:/config
      - ${MEDIA_PATH}/media:/data/media:ro
    ports:
      - "8096:8096"
{% if gpu_vendor in ('amd', 'intel') %}
    devices:
      - /dev/dri:/dev/dri
{% if render_gid %}
    group_add:
      - "{{ render_gid }}"
{% endif %}
{% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ limits.jellyfin.cpus }}"
          memory: "{{ limits.jellyfin.memory }}"
{% if gpu_vendor == 'nvidia' %}
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
{% endif %}
    restart: unless-stopped
{% endif %}
{% if 'radarr' in enabled %}
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/radarr:/config
      - ${MEDIA_PATH}:/data
    ports:
      - "7878:7878"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.radarr.cpus }}"
          memory: "{{ limits.radarr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'sonarr' in enabled %}
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/sonarr:/config
      - ${MEDIA_PATH}:/data
    ports:
      - "8989:8989"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.sonarr.cpus }}"
          memory: "{{ limits.sonarr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'prowlarr' in enabled %}
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/prowlarr:/config
    ports:
      - "9696:9696"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.prowlarr.cpus }}"
          memory: "{{ limits.prowlarr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'qbittorrent' in enabled %}
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/qbittorrent:/config
      - ${MEDIA_PATH}:/data
{% if 'gluetun' in enabled %}
    network_mode: "service:gluetun"
    depends_on:
      - gluetun
{% else %}
    ports:
      - "8080:8080"
{% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ limits.qbittorrent.cpus }}"
          memory: "{{ limits.qbittorrent.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'sabnzbd' in enabled %}
  sabnzbd:
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: sabnzbd
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/sabnzbd:/config
      - ${MEDIA_PATH}:/data
    ports:
      - "8081:8080"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.sabnzbd.cpus }}"
          memory: "{{ limits.sabnzbd.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'jellyseerr' in enabled %}
  jellyseerr:
    image: fallenbagel/jellyseerr:latest
    container_name: jellyseerr
    environment:
      - TZ=${TZ}
    volumes:
      - ./config/jellyseerr:/app/config
    ports:
      - "5055:5055"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.jellyseerr.cpus }}"
          memory: "{{ limits.jellyseerr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'bazarr' in enabled %}
  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/bazarr:/config
      - ${MEDIA_PATH}/media:/data/media
    ports:
      - "6767:6767"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.bazarr.cpus }}"
          memory: "{{ limits.bazarr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'flaresolverr' in enabled %}
  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    environment:
      - TZ=${TZ}
      - LOG_LEVEL=info
    ports:
      - "8191:8191"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.flaresolverr.cpus }}"
          memory: "{{ limits.flaresolverr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'gluetun' in enabled %}
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    environment:
      - VPN_SERVICE_PROVIDER=${VPN_SERVICE_PROVIDER}
      - VPN_TYPE=${VPN_TYPE}
      - WIREGUARD_PRIVATE_KEY=${WIREGUARD_PRIVATE_KEY}
      - TZ=${TZ}
    volumes:
      - ./config/gluetun:/gluetun
    ports:
      - "8080:8080"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.gluetun.cpus }}"
          memory: "{{ limits.gluetun.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'lidarr' in enabled %}
  lidarr:
    image: lscr.io/linuxserver/lidarr:latest
    container_name: lidarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/lidarr:/config
      - ${MEDIA_PATH}:/data
    ports:
      - "8686:8686"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.lidarr.cpus }}"
          memory: "{{ limits.lidarr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'traefik' in enabled %}
  traefik:
    image: traefik:latest
    container_name: traefik
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./config/traefik:/etc/traefik
    ports:
      - "80:80"
      - "443:443"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.traefik.cpus }}"
          memory: "{{ limits.traefik.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'homepage' in enabled %}
  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    volumes:
      - ./config/homepage:/app/config
    ports:
      - "3000:3000"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.homepage.cpus }}"
          memory: "{{ limits.homepage.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'uptime-kuma' in enabled %}
  uptime-kuma:
    image: louislam/uptime-kuma:latest
    container_name: uptime-kuma
    volumes:
      - ./config/uptime-kuma:/app/data
    ports:
      - "3001:3001"
    deploy:
      resources:
        limits:
          cpus: "{{ limits['uptime-kuma'].cpus }}"
          memory: "{{ limits['uptime-kuma'].memory }}"
    restart: unless-stopped
{% endif %}
{% if 'watchtower' in enabled %}
  watchtower:
    image: containrrr/watchtower:latest
    container_name: watchtower
    environment:
      - WATCHTOWER_CLEANUP=true
      - WATCHTOWER_POLL_INTERVAL=86400
      - TZ=${TZ}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    deploy:
      resources:
        limits:
          cpus: "{{ limits.watchtower.cpus }}"
          memory: "{{ limits.watchtower.memory }}"
    restart: unless-stopped
{% endif %}
