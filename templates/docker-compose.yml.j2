{% if 'downtify' in enabled %}
  downtify:
    image: ghcr.io/henriquesebastiao/downtify:latest
    container_name: downtify
    volumes:
      - ./config/downtify:/data
      - ${MEDIA_PATH}/media/music/downtify:/downloads
    ports:
      - "{{ ports['downtify'] }}:8000"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.downtify.rule=Host(`downtify.{{ domain }}`)"
      - "traefik.http.routers.downtify.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.downtify.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.downtify.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.downtify.loadbalancer.server.port=8000"
{% if 'crowdsec' in enabled or 'authelia' in enabled %}
      - "traefik.http.routers.downtify.middlewares={{ [('crowdsec@docker' if 'crowdsec' in enabled else none), ('authelia@docker' if 'authelia' in enabled else none)] | select | join(',') }}"
{% endif %}
{% endif %}
    # downtify runs its FastAPI app as root and, with no PUID/PGID
    # support, writes its sqlite DB straight into the bind-mounted
    # /data (and downloads into /downloads). Under cap_drop: ALL a
    # root process loses CAP_DAC_OVERRIDE too, so it can't write to a
    # host dir it doesn't own - "sqlite3.OperationalError: unable to
    # open database file", crash-loop. Verified against the real image:
    # DAC_OVERRIDE alone is enough (it doesn't chown, so CHOWN/FOWNER
    # aren't needed). The earlier "zero added capabilities" claim here
    # was tested against a root-owned/managed volume, not a real
    # non-root bind mount - found live on an Ubuntu homelab.
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.downtify.cpus }}"
          memory: "{{ limits.downtify.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'vaultwarden' in enabled %}
  vaultwarden:
    image: vaultwarden/server:latest
    container_name: vaultwarden
    environment:
      - TZ=${TZ}
      - WEBSOCKET_ENABLED=true
      - SIGNUPS_ALLOWED=${VAULTWARDEN_SIGNUPS_ALLOWED}
      - ADMIN_TOKEN=${VAULTWARDEN_ADMIN_TOKEN}
    volumes:
      - ./config/vaultwarden:/data
    ports:
      - "{{ ports['vaultwarden'] }}:80"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.vaultwarden.rule=Host(`vaultwarden.{{ domain }}`)"
      - "traefik.http.routers.vaultwarden.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.vaultwarden.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.vaultwarden.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.vaultwarden.loadbalancer.server.port=80"
      # explicit - this container defines two services (main + -ws), so
      # the main router can't be linked automatically ("cannot be linked
      # ... with multiple Services"), which silently drops the route.
      - "traefik.http.routers.vaultwarden.service=vaultwarden"
      - "traefik.http.routers.vaultwarden-ws.rule=Host(`vaultwarden.{{ domain }}`) && Path(`/notifications/hub`)"
      - "traefik.http.routers.vaultwarden-ws.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.vaultwarden-ws.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.vaultwarden-ws.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.routers.vaultwarden-ws.service=vaultwarden-ws"
      - "traefik.http.services.vaultwarden-ws.loadbalancer.server.port=3012"
{# Deliberately never gets the authelia@docker middleware, same reason
   as Jellyfin above - Vaultwarden's own official apps (browser
   extension, mobile, desktop) log in directly against its API and
   can't complete a browser SSO redirect either. Its own master
   password (plus its own optional two-factor authentication) is the
   real protection layer, same pattern as Jellyfin. Same crowdsec@docker
   exception as Jellyfin too - see its own comment above. #}
{% if 'crowdsec' in enabled %}
      - "traefik.http.routers.vaultwarden.middlewares=crowdsec@docker"
      - "traefik.http.routers.vaultwarden-ws.middlewares=crowdsec@docker"
{% endif %}
{% endif %}
    # vaultwarden runs as root and writes its sqlite DB + rsa_key.pem
    # into the bind-mounted /data. Under cap_drop: ALL a root process
    # loses CAP_DAC_OVERRIDE and can't write a dir it doesn't own
    # ("Error creating private key 'data/rsa_key.pem': permission
    # denied", crash-loop). Verified against the real image: DAC_OVERRIDE
    # alone. Same false-positive as downtify - the old "zero caps"
    # verification was against a managed volume, not a real bind mount.
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.vaultwarden.cpus }}"
          memory: "{{ limits.vaultwarden.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'recyclarr' in enabled %}
  recyclarr:
    image: ghcr.io/recyclarr/recyclarr:8
    container_name: recyclarr
    user: "${PUID}:${PGID}"
    environment:
      - TZ=${TZ}
      - CRON_SCHEDULE=@daily
      - RECYCLARR_CREATE_CONFIG=true
    volumes:
      - ./config/recyclarr:/config
    # Verified empirically (docker run --cap-drop=ALL against the real
    # image) - starts and runs cleanly with zero added capabilities, no
    # privilege-drop or ownership-fixup step to support. See
    # ROADMAP.md's cap_drop entry.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.recyclarr.cpus }}"
          memory: "{{ limits.recyclarr.memory }}"
    restart: unless-stopped
{% endif %}
