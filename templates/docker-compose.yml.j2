    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.radarr.cpus }}"
          memory: "{{ limits.radarr.memory }}"
    restart: unless-stopped
{% endif %}
