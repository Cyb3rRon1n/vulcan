    # image) - starts and runs cleanly with zero added capabilities, no
    # privilege-drop or ownership-fixup step to support. See
    # ROADMAP.md's cap_drop entry.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.dashy.cpus }}"
          memory: "{{ limits.dashy.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'uptime-kuma' in enabled %}
  uptime-kuma:
    image: louislam/uptime-kuma:latest
    container_name: uptime-kuma
    volumes:
      - ./config/uptime-kuma:/app/data
    ports:
      - "{{ ports['uptime-kuma'] }}:3001"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.uptime-kuma.rule=Host(`uptime-kuma.{{ domain }}`)"
      - "traefik.http.routers.uptime-kuma.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.uptime-kuma.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.uptime-kuma.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.uptime-kuma.loadbalancer.server.port=3001"
{% if 'crowdsec' in enabled or 'authelia' in enabled %}
      - "traefik.http.routers.uptime-kuma.middlewares={{ [('crowdsec@docker' if 'crowdsec' in enabled else none), ('authelia@docker' if 'authelia' in enabled else none)] | select | join(',') }}"
{% endif %}
{% endif %}
    # Verified empirically (docker run --cap-drop=ALL against the real
    # image, then iterated caps back in) - same 5-capability pattern as
    # the linuxserver.io images: CHOWN/DAC_OVERRIDE/FOWNER for an
    # ownership fixup on first boot, SETGID/SETUID for a root -> PUID/
    # PGID privilege drop. See ROADMAP.md's cap_drop entry.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits['uptime-kuma'].cpus }}"
          memory: "{{ limits['uptime-kuma'].memory }}"
    restart: unless-stopped
{% endif %}
{% if 'watchtower' in enabled %}
  watchtower:
    image: containrrr/watchtower:latest
    container_name: watchtower
    environment:
      - WATCHTOWER_CLEANUP=true
      - WATCHTOWER_POLL_INTERVAL=86400
      - TZ=${TZ}
      # containrrr/watchtower:latest's bundled Docker client defaults to a
      # stale API version (1.25) instead of negotiating with the real daemon,
      # which modern Docker Engine (min supported API 1.40+) rejects outright
      # and then nil-pointer-panics on. Pinning a conservative, broadly
      # compatible version (Docker 20.10+, released 2020) works around it.
      - DOCKER_API_VERSION=1.41
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    # Verified empirically (docker run --cap-drop=ALL against the real
    # image) - starts and runs cleanly with zero added capabilities, no
    # privilege-drop or ownership-fixup step to support. See
    # ROADMAP.md's cap_drop entry.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.watchtower.cpus }}"
          memory: "{{ limits.watchtower.memory }}"
    restart: unless-stopped
{% endif %}
