{% if 'tailscale' in enabled %}
  tailscale:
    image: tailscale/tailscale:latest
    container_name: tailscale
    hostname: vulcan
    environment:
      - TS_AUTHKEY=${TS_AUTHKEY}
      - TS_STATE_DIR=/var/lib/tailscale
      # network_mode: host means TS_ACCEPT_DNS=true would rewrite the
      # *host's* /etc/resolv.conf to Tailscale MagicDNS. Off when a local
      # DNS server is in the stack (pihole/adguardhome) so it doesn't
      # hijack the resolver you just set up - on otherwise, so MagicDNS
      # name resolution across the tailnet still works out of the box.
      - TS_ACCEPT_DNS={{ 'false' if ('pihole' in enabled or 'adguardhome' in enabled) else 'true' }}
    volumes:
      - ./config/tailscale:/var/lib/tailscale
      - /dev/net/tun:/dev/net/tun
    # tailscaled runs as root and manages its state store in the
    # bind-mounted /var/lib/tailscale: it writes files (needs
    # DAC_OVERRIDE - the dir is owned by PUID, not root) and `chmod 0700`s
    # the dir itself (needs FOWNER - chmod on a file you don't own).
    # Under cap_drop: ALL, without both: "state store failed to
    # initialize ... chmod /var/lib/tailscale: operation not permitted",
    # crash-loop. NET_ADMIN/NET_RAW are for the tun device. The earlier
    # "sufficient as-is" check wrote into a root-owned dir, not a real
    # non-root bind mount.
    cap_drop:
      - ALL
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - DAC_OVERRIDE
      - FOWNER
    network_mode: host
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.tailscale.cpus }}"
          memory: "{{ limits.tailscale.memory }}"
    restart: unless-stopped
{% endif %}
