{% if 'netdata' in enabled %}
  netdata:
    image: netdata/netdata:stable
    container_name: netdata
    pid: host
    network_mode: host
    # Verified empirically (docker run --cap-drop=ALL against the real
    # image, then iterated caps back in) - extends the pre-existing
    # SYS_PTRACE/SYS_ADMIN (host process/cgroup monitoring) with the
    # same ownership-fixup set every other PUID/PGID-style image in this
    # file needed, plus DAC_READ_SEARCH, which netdata's own
    # apps.plugin/debugfs.plugin log wanting directly ("should run with
    # CAP_DAC_READ_SEARCH") - without it they degrade silently rather
    # than crash, so this is a real functionality gain, not just noise
    # suppression. A real, honest limit found in the longer full-28-service
    # verification run (ROADMAP.md): apps.plugin's own internal per-process
    # UID-cycling still logs repeated "setresuid(0, 0, 0) failed" even with
    # SETUID granted - the core daemon and every other collector run
    # cleanly and the container reports healthy, but apps.plugin's own
    # per-process resource attribution stays degraded under this hardening.
    # Not chased further - the alternative is granting broader privilege
    # than this pass's own goal. See ROADMAP.md's cap_drop entry.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - DAC_READ_SEARCH
      - FOWNER
      - SETGID
      - SETUID
      - SYS_PTRACE
      - SYS_ADMIN
    security_opt:
      - apparmor:unconfined
      - no-new-privileges:true
    volumes:
      - ./config/netdata/config:/etc/netdata
      - ./config/netdata/lib:/var/lib/netdata
      - ./config/netdata/cache:/var/cache/netdata
      - /:/host/root:ro,rslave
      - /etc/passwd:/host/etc/passwd:ro
      - /etc/group:/host/etc/group:ro
      - /etc/localtime:/etc/localtime:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /etc/os-release:/host/etc/os-release:ro
      - /var/log:/host/var/log:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /run/dbus:/run/dbus:ro
    deploy:
      resources:
        limits:
          cpus: "{{ limits.netdata.cpus }}"
          memory: "{{ limits.netdata.memory }}"
    restart: unless-stopped
