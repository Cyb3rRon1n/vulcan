{% if 'gluetun' in enabled %}
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    environment:
      - VPN_SERVICE_PROVIDER=${VPN_SERVICE_PROVIDER}
      - VPN_TYPE=${VPN_TYPE}
      - WIREGUARD_PRIVATE_KEY=${WIREGUARD_PRIVATE_KEY}
      - TZ=${TZ}
    volumes:
      - ./config/gluetun:/gluetun
    ports:
      # Effectively qBittorrent's port - see check_ports_available()'s
      # own comment on why the remap key is "qbittorrent", not
      # "gluetun".
      - "{{ ports['qbittorrent'] }}:8080"
    deploy:
      resources:
        limits:
          cpus: "{{ limits.gluetun.cpus }}"
          memory: "{{ limits.gluetun.memory }}"
    restart: unless-stopped
{% endif %}
