services:
{% if 'jellyfin' in enabled %}
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/jellyfin:/config
      - ${MEDIA_PATH}/media:/data/media:ro
    ports:
      - "{{ ports['jellyfin'] }}:8096"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin.rule=Host(`jellyfin.{{ domain }}`)"
      - "traefik.http.routers.jellyfin.entrypoints=websecure"
      - "traefik.http.routers.jellyfin.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.jellyfin.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.jellyfin.loadbalancer.server.port=8096"
{% if 'authelia' in enabled %}
      - "traefik.http.routers.jellyfin.middlewares=authelia@docker"
{% endif %}
{% endif %}
{% if gpu_vendor in ('amd', 'intel') %}
    devices:
      - /dev/dri:/dev/dri
{% if render_gid %}
    group_add:
      - "{{ render_gid }}"
{% endif %}
{% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ limits.jellyfin.cpus }}"
          memory: "{{ limits.jellyfin.memory }}"
{% if gpu_vendor == 'nvidia' %}
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
{% endif %}
    restart: unless-stopped
{% endif %}
{% if 'radarr' in enabled %}
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/radarr:/config
      - ${MEDIA_PATH}:/data
    ports:
      - "{{ ports['radarr'] }}:7878"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.radarr.rule=Host(`radarr.{{ domain }}`)"
      - "traefik.http.routers.radarr.entrypoints=websecure"
      - "traefik.http.routers.radarr.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.radarr.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.radarr.loadbalancer.server.port=7878"
{% if 'authelia' in enabled %}
      - "traefik.http.routers.radarr.middlewares=authelia@docker"
{% endif %}
{% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ limits.radarr.cpus }}"
          memory: "{{ limits.radarr.memory }}"
    restart: unless-stopped
{% endif %}
{% if 'sonarr' in enabled %}
  sonarr:
