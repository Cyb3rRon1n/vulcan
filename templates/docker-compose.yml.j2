services:
{% if 'jellyfin' in enabled %}
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/jellyfin:/config
      - ${MEDIA_PATH}/media:/data/media:ro
    ports:
      - "{{ ports['jellyfin'] }}:8096"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin.rule=Host(`jellyfin.{{ domain }}`)"
      - "traefik.http.routers.jellyfin.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.jellyfin.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.jellyfin.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.jellyfin.loadbalancer.server.port=8096"
{# Deliberately never gets the authelia@docker middleware, even with
   Authelia enabled - forward-auth's browser-redirect login can't be
   completed by native Jellyfin apps (phone/TV clients), a real,
   community-documented conflict (jellyfin/jellyfin#16956). Jellyfin's
   own login (plus its own two-factor plugin, recommended in
   write_stack()'s warning) is the real protection layer here instead.
   crowdsec@docker is unaffected by that conflict - it's IP-reputation
   /behavior blocking at the edge, not an auth challenge, so it doesn't
   break native app logins the way Authelia's redirect does. #}
{% if 'crowdsec' in enabled %}
      - "traefik.http.routers.jellyfin.middlewares=crowdsec@docker"
{% endif %}
{% endif %}
{% if gpu_vendor in ('amd', 'intel') %}
    devices:
      - /dev/dri:/dev/dri
{% if render_gid %}
    group_add:
      - "{{ render_gid }}"
{% endif %}
{% endif %}
    # Verified empirically (docker run --cap-drop=ALL against the real
    # image, then iterated caps back in) - see ROADMAP.md's cap_drop
    # entry. Same 5 capabilities across all 9 linuxserver.io images in
    # this stack: CHOWN/DAC_OVERRIDE/FOWNER for the s6-overlay init's
    # ownership fixup on /config et al., SETGID/SETUID for the actual
    # root -> PUID/PGID drop. Without these five, s6-overlay fails
    # loudly (s6-applyuidgid: fatal: unable to set supplementary group
    # list) rather than silently degrading, so a future linuxserver.io
    # base-image change breaking this would be immediately visible on
    # container start, not a silent security regression.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: "{{ limits.jellyfin.cpus }}"
          memory: "{{ limits.jellyfin.memory }}"
{% if gpu_vendor == 'nvidia' %}
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8096/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s
    restart: unless-stopped
{% endif %}
{% if 'radarr' in enabled %}
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./config/radarr:/config
      - ${MEDIA_PATH}:/data
    ports:
      - "{{ ports['radarr'] }}:7878"
{% if 'traefik' in enabled and domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.radarr.rule=Host(`radarr.{{ domain }}`)"
      - "traefik.http.routers.radarr.entrypoints=websecure{{ tunnel_entrypoints }}"
      - "traefik.http.routers.radarr.tls=true"
{% if cloudflare_dns %}
      - "traefik.http.routers.radarr.tls.certresolver=cloudflare"
{% endif %}
      - "traefik.http.services.radarr.loadbalancer.server.port=7878"
{% if 'crowdsec' in enabled or 'authelia' in enabled %}
      - "traefik.http.routers.radarr.middlewares={{ [('crowdsec@docker' if 'crowdsec' in enabled else none), ('authelia@docker' if 'authelia' in enabled else none)] | select | join(',') }}"
{% endif %}
{% endif %}
    # Verified empirically (docker run --cap-drop=ALL against the real
