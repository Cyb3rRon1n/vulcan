---
server:
  address: 'tcp://:9091'

log:
  level: 'info'

totp:
  issuer: 'authelia'

authentication_backend:
  file:
    path: '/config/users_database.yml'

access_control:
  default_policy: 'one_factor'
{% if domain and admin_only_services %}
  rules:
{% for service in admin_only_services %}
    - domain: '{{ service }}.{{ domain }}'
      policy: 'one_factor'
      subject: ['group:admin']
{% endfor %}
{% endif %}

session:
  cookies:
    - name: 'authelia_session'
      domain: '{{ cookie_domain }}'
{% if domain %}
      authelia_url: 'https://authelia.{{ domain }}'
{% else %}
      # authelia_url is a required field - with no real domain configured
      # (see cookie_domain's fallback above), this points at Authelia's own
      # container port directly rather than a fictional "authelia.<ip>"
      # subdomain, which wouldn't resolve to anything.
      authelia_url: 'https://{{ cookie_domain }}:9091'
{% endif %}
      expiration: '1 hour'
      inactivity: '5 minutes'
{% if homepage_enabled and domain %}
      default_redirection_url: 'https://homepage.{{ domain }}'
{% endif %}

regulation:
  max_retries: 3
  find_time: '2 minutes'
  ban_time: '5 minutes'

storage:
  local:
    path: '/config/db.sqlite3'

notifier:
  filesystem:
    filename: '/config/notification.txt'
...
