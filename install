#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"
REQUIRED_VERSION="3.11"

if ! command -v python3 &> /dev/null; then
    echo "python3 is required but was not found - attempting to install it." >&2

    # python3 is the one bootstrap dependency that must exist before the
    # venv can be created, so it's handled here in bash. Same distro-family
    # mapping as installer/deps.py.
    if [ -f /etc/os-release ]; then
        . /etc/os-release
    fi

    case "${ID:-}" in
        ubuntu|debian|raspbian|linuxmint)
            BOOTSTRAP_DEPS=(apt-get install -y python3 python3-venv) ;;
        fedora|rhel|centos|rocky|almalinux)
            BOOTSTRAP_DEPS=(dnf install -y python3) ;;
        arch)
            BOOTSTRAP_DEPS=(pacman -Sy --noconfirm python) ;;
        *)
            echo "Unsupported distro (ID=${ID:-unknown}). Install Python $REQUIRED_VERSION+ manually and re-run." >&2
            exit 1 ;;
    esac

    if [ "$(id -u)" -ne 0 ]; then
        echo "Installing python3 needs root - re-run as: sudo $0 $*" >&2
        exit 1
    fi

    "${BOOTSTRAP_DEPS[@]}"
fi

PYTHON_VERSION="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"

if [ "$(printf '%s\n' "$REQUIRED_VERSION" "$PYTHON_VERSION" | sort -V | head -n1)" != "$REQUIRED_VERSION" ]; then
    echo "Python $REQUIRED_VERSION+ is required (found $PYTHON_VERSION)." >&2
    exit 1
fi

# Everything past the python3 bootstrap above touches the checkout - the
# venv, the editable install, and the CLI itself (which writes stack/,
# and .git/ on `vulcan update`). Run it as the real user when invoked
# via sudo, so `sudo ./install` doesn't leave root-owned files behind
# that break git for the user afterward. The CLI re-escalates with sudo
# per-command for the few steps that genuinely need root.
RUN_AS=()
if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    RUN_AS=(runuser -u "$SUDO_USER" --)
fi

if [ ! -d "$VENV_DIR" ] || ! "${RUN_AS[@]}" "$VENV_DIR/bin/python" -c "import installer.cli" &>/dev/null; then
    echo "Setting up Vulcan (first run)..."
    "${RUN_AS[@]}" python3 -m venv "$VENV_DIR"
    "${RUN_AS[@]}" "$VENV_DIR/bin/pip" install --quiet --upgrade pip
    "${RUN_AS[@]}" "$VENV_DIR/bin/pip" install --quiet -e "$SCRIPT_DIR"
fi

# --- Phase 0: system packages + Docker (one privileged pass) ---------
# NOT via "${RUN_AS[@]}": on the `exec sudo` re-exec below we are root
# with SUDO_USER set, so RUN_AS would drop preflight back to the
# unprivileged user and it could never satisfy its own needs_root check.
# preflight must run with whatever privilege `install` itself has.
# PYTHONDONTWRITEBYTECODE=1 so a root-run preflight leaves no root-owned
# installer/__pycache__/*.pyc behind. (phase0.ensure_system_ready
# defaults the docker-group user to $SUDO_USER, so it still targets the
# real user.)
if ! PYTHONDONTWRITEBYTECODE=1 "$VENV_DIR/bin/python" -m installer preflight --fix; then
    if [ "$(id -u)" -ne 0 ]; then
        echo
        echo "Vulcan needs root once to install:"
        echo "  - system packages (git, whiptail, mdadm, ...)"
        echo "  - Docker Engine + docker compose"
        echo "Escalating now (Ctrl-C to abort)..."
        echo
        exec sudo "$0" "$@"
    fi
    echo "Phase 0 failed - see the errors above." >&2
    exit 1
fi

exec "${RUN_AS[@]}" "$VENV_DIR/bin/python" -m installer "$@"
